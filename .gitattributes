# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary

# Fork merge strategy
# These files are heavily modified from upstream and Bindery always owns them.
# During `git merge upstream/main`, our version wins automatically.
# Requires: git config merge.ours.driver true  (run scripts/setup-fork.sh once)
tsconfig.json merge=ours
package.json merge=ours
package-lock.json merge=ours

# Upstream packages stripped from this fork - always delete on conflict
packages/mom/** merge=ours
packages/web-ui/** merge=ours
packages/pods/** merge=ours
packages/agent-old/** merge=ours

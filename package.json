{
  "name": "bindery",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/coding-agent",
    "bindery-tools"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces",
    "build": "cd packages/coding-agent && npm run build",
    "dev": "cd packages/coding-agent && npm run dev",
    "check": "biome check --write --error-on-warnings . && tsgo --noEmit",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "^26.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "husky": "^9.1.7",
    "shx": "^0.4.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "version": "0.0.3",
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "get-east-asian-width": "^1.6.0"
  },
  "overrides": {
    "rimraf": "6.1.2",
    "fast-xml-parser": "5.3.8",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  }
}

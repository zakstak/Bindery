{
	"name": "bindery",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/coding-agent",
		"bindery-tools"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/coding-agent && npm run build",
		"dev": "cd packages/coding-agent && npm run dev",
		"check": "biome check --write --error-on-warnings . && tsgo --noEmit",
		"test": "npm run test --workspaces --if-present",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/node": "^26.1.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"husky": "^9.1.7",
		"shx": "^0.4.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.80.10",
		"get-east-asian-width": "^1.6.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"fast-xml-parser": "5.3.8",
		"@protobufjs/utf8": "1.1.2",
		"protobufjs": "7.6.5",
		"ws": "8.21.0",
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}

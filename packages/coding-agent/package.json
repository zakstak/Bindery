{
	"name": "@earendil-works/pi-coding-agent",
	"version": "0.80.6",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"piConfig": {
		"name": "pi",
		"configDir": ".pi"
	},
	"bin": {
		"pi": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/core/hooks/index.d.ts",
			"import": "./dist/core/hooks/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.80.6",
		"@earendil-works/pi-ai": "^0.80.6",
		"ajv": "^8.20.0",
		"bindery-tools": "*",

		"diff": "^9.0.0",
		"file-type": "^22.0.1",
		"glob": "^13.0.6",

		"ignore": "^7.0.5",

		"minimatch": "^10.2.5",
		"proper-lockfile": "^4.1.2",
		"strip-ansi": "^7.2.0",
		"undici": "^8.7.0",

		"tsx": "^4.23.0",
		"typebox": "^1.3.6",
		"yaml": "^2.9.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"@protobufjs/utf8": "1.1.2",
		"protobufjs": "7.6.5",
		"ws": "8.21.0",
		"micromatch": {
			"picomatch": "2.3.2"
		},
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"devDependencies": {
		"@types/ms": "^2.1.0",
		"@types/node": "^26.1.1",
		"@types/proper-lockfile": "^4.1.4",

		"shx": "^0.4.0",
		"typescript": "^7.0.2",
		"vitest": "^3.2.7"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}

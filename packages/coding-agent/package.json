{
  "name": "@mariozechner/pi-coding-agent",
  "version": "0.57.1",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "type": "module",
  "piConfig": {
    "name": "pi",
    "configDir": ".pi"
  },
  "bin": {
    "pi": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/core/hooks/index.d.ts",
      "import": "./dist/core/hooks/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "bindery-tools": "*",
    "diff": "^9.0.0",
    "file-type": "^22.0.1",
    "glob": "^13.0.6",
    "ignore": "^7.0.5",
    "minimatch": "^10.2.5",
    "proper-lockfile": "^4.1.2",
    "strip-ansi": "^7.2.0",
    "undici": "^8.5.0",
    "tsx": "^4.22.4",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "rimraf": "6.1.2",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "cli",
    "tui",
    "agent"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badlogic/pi-mono.git",
    "directory": "packages/coding-agent"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}

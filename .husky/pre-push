#!/bin/sh

set -eu

remote_name=${1:-origin}
zero_oid=0000000000000000000000000000000000000000
scanned_ref=0

if ! command -v gitleaks >/dev/null 2>&1; then
	printf '%s\n' 'gitleaks is required for pre-push checks. Install it from https://github.com/gitleaks/gitleaks#installing and retry.'
	exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
	if [ -z "${local_ref:-}" ]; then
		continue
	fi

	if [ "$local_sha" = "$zero_oid" ]; then
		continue
	fi

	if [ "$remote_sha" = "$zero_oid" ]; then
		log_opts="$local_sha --not --remotes=$remote_name"
	else
		log_opts="$remote_sha..$local_sha"
	fi

	scanned_ref=1
	printf '%s\n' "Running gitleaks for $local_ref -> $remote_ref"
	gitleaks git --redact --no-banner --log-opts="$log_opts"
done

if [ "$scanned_ref" -eq 0 ]; then
	printf '%s\n' 'No pushed commits to scan with gitleaks.'
fi
